# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (Object Method)
SQL_HOST="/cloudsql/instance-connection-name"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="your_password"

# Cloud SQL Admin Variables (Drizzle Kit Migrations)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your_admin_password"

# Optional Default Google Sheets ID for Attendance & Startup Help Sync
GOOGLE_SHEETS_SPREADSHEET_ID=""

